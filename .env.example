# ==============================================================================
# HRITIKPEDIA ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Official Tagline: Stop Searching. Start Learning.
# Zero-Budget-First Policy: All local features run with zero-cost defaults.
# NEVER commit production secrets or real API keys to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
ADMIN_PORT=3001

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Production targets:
# NEXT_PUBLIC_APP_URL=https://hritikpedia.vercel.app
# NEXT_PUBLIC_ADMIN_URL=https://hritikpedia-admin.vercel.app
# Future custom domains:
# NEXT_PUBLIC_APP_URL=https://hritikpedia.com
# NEXT_PUBLIC_ADMIN_URL=https://admin.hritikpedia.com

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Production / Staging: connection string to PostgreSQL instance (Neon, Render, RDS, local)
# Example: postgres://username:password@ep-cool-fog-12345.ap-southeast-1.aws.neon.tech/hritikpedia?sslmode=require
DATABASE_URL=
# Connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# Zero-budget local development fallback:
# If DATABASE_URL is empty, Hritikpedia automatically initializes embedded WASM PostgreSQL via PGlite

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSIONS
# ------------------------------------------------------------------------------
# 32+ character high-entropy secret for signing JWTs and session cookies
JWT_SECRET=replace_with_64_char_secure_random_hex_string_for_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=hritikpedia_session
ADMIN_COOKIE_NAME=hritikpedia_admin_session
COOKIE_SECURE=false # Set to true in production over HTTPS

# Super Admin Initial Provisioning (used strictly during initial migration seed if not set)
SUPER_ADMIN_EMAIL=admin@hritikpedia.com
SUPER_ADMIN_PASSWORD=ChangeMeOnFirstLogin#2026!
SUPER_ADMIN_NAME="Hritikpedia Super Admin"

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Keys obtained from Razorpay Dashboard (Test Mode: rzp_test_..., Live Mode: rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_hmac
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
PAYMENT_CURRENCY=INR

# ------------------------------------------------------------------------------
# 4. PRIVATE FILE STORAGE (PDFs, Notes Assets)
# ------------------------------------------------------------------------------
# Provider: local_disk (default for local dev) | cloudflare_r2 | aws_s3
STORAGE_PROVIDER=local_disk
STORAGE_LOCAL_PATH=./storage/private

# Cloudflare R2 / S3 Configuration (Optional for cloud deployment)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hritikpedia-private-notes
R2_PUBLIC_DOMAIN=

# ------------------------------------------------------------------------------
# 5. WATERMARKING ENGINE
# ------------------------------------------------------------------------------
WATERMARK_ENABLED=true
WATERMARK_OPACITY=0.18
WATERMARK_FONT_SIZE=14
WATERMARK_REPEAT_INTERVAL=160
WATERMARK_INCLUDE_TIMESTAMP=true
WATERMARK_INCLUDE_MASKED_EMAIL=true

# ------------------------------------------------------------------------------
# 6. ADVERTISING MONETIZATION (AdSense & Direct Sponsors)
# ------------------------------------------------------------------------------
# Google AdSense (disabled by default until official Google approval)
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# Direct Sponsor Ads (enabled by default with in-house educational sponsor slots)
ENABLE_DIRECT_SPONSOR_ADS=true

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (Transactional & Newsletter)
# ------------------------------------------------------------------------------
# Provider: console (logs to stdout in dev) | resend | ses | smtp
EMAIL_PROVIDER=console
EMAIL_FROM="Hritikpedia <noreply@hritikpedia.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# 8. SMS & WHATSAPP BUSINESS INTEGRATION (Optional / Disabled by Default)
# ------------------------------------------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=HRITIK

WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=official_meta
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 9. SECURITY, ANTI-BOT & RATE LIMITING
# ------------------------------------------------------------------------------
# Cloudflare Turnstile CAPTCHA (Optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate Limits (Requests per minute per IP)
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_CHECKOUT=20
RATE_LIMIT_SEARCH=60

# ------------------------------------------------------------------------------
# 10. AUDIT LOGGING & MONITORING
# ------------------------------------------------------------------------------
LOG_LEVEL=info
SECURITY_AUDIT_ENABLED=true
SLACK_ALERT_WEBHOOK=
DISCORD_ALERT_WEBHOOK=
